<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GestionNotesEtudiant.Views.ProfilPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:GestionNotesEtudiant.Controls"
    xmlns:vm="clr-namespace:GestionNotesEtudiant.ViewModels"
    x:DataType="vm:ProfilViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16,28,16,16" Spacing="16">
            <Label Text="Profil" Style="{StaticResource TitreEcran}" />

            <Border Style="{StaticResource Carte}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border
                        WidthRequest="56"
                        HeightRequest="56"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 28"
                        BackgroundColor="{StaticResource PrimaireClair}">
                        <Label
                            Text="{Binding Initiales}"
                            FontFamily="{StaticResource PoliceGras}"
                            FontSize="19"
                            TextColor="{StaticResource Primaire}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding Nom}" Style="{StaticResource Libelle}" FontSize="17" />
                        <Label Text="{Binding Email}" Style="{StaticResource TexteSecondaire}" />
                        <c:Etiquette Texte="{Binding Role}" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource Carte}" Padding="16,4">
                <VerticalStackLayout>
                    <VerticalStackLayout Padding="0,12" Spacing="2">
                        <Label Text="Période" Style="{StaticResource TexteSecondaire}" />
                        <Label Text="{Binding Semestre}" Style="{StaticResource Libelle}" />
                    </VerticalStackLayout>
                    <BoxView Style="{StaticResource Separateur}" />
                    <VerticalStackLayout Padding="0,12" Spacing="2">
                        <Label Text="Enseignements" Style="{StaticResource TexteSecondaire}" />
                        <Label Text="{Binding Resume}" Style="{StaticResource Libelle}" />
                    </VerticalStackLayout>
                    <BoxView Style="{StaticResource Separateur}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,12">
                        <Image Source="ic_appareil.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Start" />
                        <Label
                            Grid.Column="1"
                            Text="Les notes sont enregistrées sur cet appareil. Aucune donnée n'est envoyée sans action de votre part."
                            Style="{StaticResource TexteSecondaire}"
                            LineHeight="1.3" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button
                Text="Se déconnecter"
                ImageSource="ic_deconnexion.png"
                Style="{StaticResource BoutonSecondaire}"
                TextColor="{StaticResource Erreur}"
                BorderColor="{StaticResource Erreur}"
                Command="{Binding DeconnecterCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
