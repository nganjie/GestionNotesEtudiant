<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Typographie : Hanken Grotesk, 3 graisses -->
    <x:String x:Key="PoliceNormale">HankenRegular</x:String>
    <x:String x:Key="PoliceDemiGras">HankenSemiBold</x:String>
    <x:String x:Key="PoliceGras">HankenBold</x:String>

    <!-- Espacements (grille de 4) -->
    <Thickness x:Key="MargeEcran">16,0</Thickness>
    <x:Double x:Key="HauteurBouton">54</x:Double>
    <x:Double x:Key="HauteurChamp">50</x:Double>

    <!-- Pages -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Fond}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <!-- Textes -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PoliceNormale}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
    </Style>

    <Style x:Key="TitreEcran" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PoliceGras}" />
        <Setter Property="FontSize" Value="28" />
    </Style>

    <Style x:Key="TitreSection" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PoliceGras}" />
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style x:Key="TitreBarre" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PoliceDemiGras}" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="Libelle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PoliceDemiGras}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="LibelleChamp" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PoliceDemiGras}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="TexteSecondaire" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TexteSecondaire}" />
    </Style>

    <Style x:Key="TexteCourantSecondaire" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource TexteSecondaire}" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style x:Key="Surtitre" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PoliceDemiGras}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="0.6" />
        <Setter Property="TextColor" Value="{StaticResource Primaire}" />
    </Style>

    <Style x:Key="Lien" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PoliceDemiGras}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource Primaire}" />
    </Style>

    <Style x:Key="Chiffre" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PoliceGras}" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- Boutons : normal, appuyé, désactivé -->
    <Style x:Key="BoutonPrimaire" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PoliceDemiGras}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource Surface}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Primaire}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="HeightRequest" Value="{StaticResource HauteurBouton}" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="ContentLayout" Value="Left,10" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaireAppuye}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Desactive}" />
                            <Setter Property="TextColor" Value="{StaticResource TexteDesactive}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BoutonPrimaire}" />

    <Style x:Key="BoutonSecondaire" TargetType="Button" BasedOn="{StaticResource BoutonPrimaire}">
        <Setter Property="TextColor" Value="{StaticResource Primaire}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="BorderColor" Value="{StaticResource Primaire}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaireClair}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BorderColor" Value="{StaticResource Bordure}" />
                            <Setter Property="TextColor" Value="{StaticResource TexteDesactive}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="BoutonLien" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PoliceDemiGras}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource Primaire}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="ContentLayout" Value="Left,6" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource PrimaireAppuye}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource TexteDesactive}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Champs -->
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="{StaticResource PoliceNormale}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TexteDesactive}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{StaticResource PoliceNormale}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource Primaire}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Primaire}" />
        <Setter Property="ThumbColor" Value="{StaticResource Surface}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="OnColor" Value="{StaticResource Desactive}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="ToggleStates">
                    <VisualState x:Name="On">
                        <VisualState.Setters>
                            <Setter Property="ThumbColor" Value="{StaticResource Surface}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Off">
                        <VisualState.Setters>
                            <Setter Property="ThumbColor" Value="{StaticResource Surface}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Primaire}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource Primaire}" />
    </Style>

    <!-- Conteneurs -->
    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource Bordure}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
    </Style>

    <Style x:Key="Carte" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource Bordure}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="Separateur" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource Bordure}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="BlocSquelette" TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource Squelette}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="HeightRequest" Value="12" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="BoutonIcone" TargetType="ImageButton">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="CornerRadius" Value="22" />
    </Style>

    <!-- Shell : barre d'onglets -->
    <Style x:Key="ShellBase" TargetType="Element">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Fond}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource Encre}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource Encre}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Primaire}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Primaire}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TexteSecondaire}" />
    </Style>
    <Style TargetType="TabBar" BasedOn="{StaticResource ShellBase}" ApplyToDerivedTypes="True" />
    <Style TargetType="ShellContent" BasedOn="{StaticResource ShellBase}" ApplyToDerivedTypes="True" />

</ResourceDictionary>
