<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Charte graphique Barème -->
    <Color x:Key="Encre">#141A2A</Color>
    <Color x:Key="Primaire">#1E3A8A</Color>
    <Color x:Key="PrimaireClair">#E8ECF7</Color>
    <Color x:Key="PrimaireAppuye">#152B66</Color>
    <Color x:Key="Fond">#F5F6F8</Color>
    <Color x:Key="Bordure">#D9DDE5</Color>
    <Color x:Key="TexteSecondaire">#566074</Color>
    <Color x:Key="Erreur">#B3261E</Color>
    <Color x:Key="ErreurClair">#FBE9E8</Color>
    <Color x:Key="Succes">#17663F</Color>
    <Color x:Key="SuccesClair">#E2F1E8</Color>
    <Color x:Key="Attention">#8A4500</Color>
    <Color x:Key="AttentionClair">#FDEBD3</Color>
    <Color x:Key="Desactive">#E4E7EC</Color>
    <Color x:Key="TexteDesactive">#7A8396</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Squelette">#E4E7EC</Color>

    <SolidColorBrush x:Key="PrimaireBrush" Color="{StaticResource Primaire}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="FondBrush" Color="{StaticResource Fond}" />
</ResourceDictionary>
